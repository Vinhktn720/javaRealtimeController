    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "MainApp",
            "request": "launch",
            "mainClass": "app.MainApp",
            "projectName": "java_runtime_controller",
            "vmArgs": "--enable-native-access=ALL-UNNAMED --add-opens java.base/sun.misc=ALL-UNNAMED"
        }
    ]
}